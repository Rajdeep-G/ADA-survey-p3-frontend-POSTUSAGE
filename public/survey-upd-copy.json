          "colCount": 5,
          "choices": [
            "Much lower",
            "Slightly lower",
            "No change",
            "Slightly higher",
            "Much higher"
          ]
        },

        {
          "type": "html",
          "name": "A2_T2",
          "html": "<div style=\"background:#f0f4ff; border-left:4px solid #4f46e5; padding:12px 16px; border-radius:6px; margin-bottom:8px;\"><p style=\"margin:0 0 12px;\">Please rate your agreement with each statement below, grouped into three areas:</p><div style=\"display:flex; gap:10px; margin-bottom:12px;\"><div style=\"flex:1; background:#ffffff; border:1px solid #c7d2fe; border-radius:6px; padding:8px 10px; text-align:center; font-weight:600; color:#4338ca;\">System Quality</div><div style=\"flex:1; background:#ffffff; border:1px solid #c7d2fe; border-radius:6px; padding:8px 10px; text-align:center; font-weight:600; color:#4338ca;\">Ease of Use &amp; Interaction Experience</div><div style=\"flex:1; background:#ffffff; border:1px solid #c7d2fe; border-radius:6px; padding:8px 10px; text-align:center; font-weight:600; color:#4338ca;\">Perceived Usefulness</div></div><p style=\"margin:0; font-size:0.9em; color:#555;\">On a scale of 1 to 5, where <strong>1</strong> indicates &ldquo;Strongly disagree&rdquo; and <strong>5</strong> indicates &ldquo;Strongly agree.&rdquo;</p></div>"
        },
        {
          "type": "matrix",
          "name": "A2_Q2",
